		user_name  TEXT NOT NULL,
		name       TEXT NOT NULL,
		document   TEXT NOT NULL,
		PRIMARY KEY (account_id, user_name, name),
		FOREIGN KEY (account_id, user_name) REFERENCES iam_users(account_id, name) ON DELETE CASCADE
	)

=== table user_policy_attachments
CREATE TABLE user_policy_attachments (
		account_id TEXT NOT NULL,
		user_name  TEXT NOT NULL,
		policy_arn TEXT NOT NULL,
		PRIMARY KEY (account_id, user_name, policy_arn),
		FOREIGN KEY (account_id, user_name) REFERENCES iam_users(account_id, name) ON DELETE CASCADE
	)

=== trigger dynamodb_tables_drop_resource_tags
CREATE TRIGGER dynamodb_tables_drop_resource_tags AFTER DELETE ON dynamodb_tables BEGIN
				DELETE FROM resource_tags WHERE account_id = OLD.account_id AND arn = OLD.arn;
			END

=== trigger ec2_eips_drop_tags
CREATE TRIGGER ec2_eips_drop_tags AFTER DELETE ON ec2_eips BEGIN
			DELETE FROM ec2_tags WHERE account_id = OLD.account_id AND resource_id = OLD.allocation_id;
		END

=== trigger ec2_instances_drop_tags
CREATE TRIGGER ec2_instances_drop_tags AFTER DELETE ON ec2_instances BEGIN
				DELETE FROM ec2_tags WHERE account_id = OLD.account_id AND resource_id = OLD.id;
			END

=== trigger ec2_internet_gateways_drop_tags
CREATE TRIGGER ec2_internet_gateways_drop_tags AFTER DELETE ON ec2_internet_gateways BEGIN
				DELETE FROM ec2_tags WHERE account_id = OLD.account_id AND resource_id = OLD.id;
			END

=== trigger ec2_key_pairs_drop_tags
CREATE TRIGGER ec2_key_pairs_drop_tags AFTER DELETE ON ec2_key_pairs BEGIN
			DELETE FROM ec2_tags WHERE account_id = OLD.account_id AND resource_id = json_extract(OLD.data, '$.key_pair_id');
		END

=== trigger ec2_network_interfaces_drop_tags
CREATE TRIGGER ec2_network_interfaces_drop_tags AFTER DELETE ON ec2_network_interfaces BEGIN
				DELETE FROM ec2_tags WHERE account_id = OLD.account_id AND resource_id = OLD.id;
			END

